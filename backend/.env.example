# ==============================================================================
# LifeLine AI Backend Environment Variables
# Copy this file to .env and provide your secret credentials.
# ==============================================================================

# Database Connection URL
# For production (PostgreSQL on Render/Railway/Neon/Supabase):
# DATABASE_URL=postgresql://user:password@hostname:5432/lifeline
# If left commented or unreachable, backend safely defaults to local SQLite:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifeline

# ------------------------------------------------------------------------------
# Email Service (SMTP) Configuration
# Required for sending Welcome emails, Password Reset codes, & Change Confirmations
# ------------------------------------------------------------------------------
# For Gmail:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password" (choose "Mail" / "Other"): https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and 16-character App Password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=LifeLine

# For SendGrid / Mailgun / Amazon SES:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM_EMAIL=notifications@yourdomain.com
# SMTP_FROM_NAME=LifeLine AI

# ------------------------------------------------------------------------------
# Google OAuth Configuration (Optional)
# Matches the Google Cloud OAuth 2.0 Client ID created in Google Cloud Console
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

